APP_NAME="ATA Cafe & Billiard PIMS"
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=["http://localhost:3000"]

DATABASE_URL=postgresql+asyncpg://ata_pims:ata_pims_password@localhost:5432/ata_pims
SYNC_DATABASE_URL=postgresql://ata_pims:ata_pims_password@localhost:5432/ata_pims

JWT_SECRET_KEY=change-this-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

EXPORT_DIR=exports
BACKUP_DIR=backups
BACKUP_RETENTION_DAYS=30

